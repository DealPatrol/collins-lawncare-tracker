rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
//
// Collection: users/{userId}/data
// Document ID: app (only document allowed)
// Fields:
//   - jobs: list (required) — array of job objects, max 200 entries
//   - workday: map | null (optional) — current workday state
//   - homeAddress: string (optional) — max 500 characters
//   - homeCoords: map | null (optional) — { lat: number, lng: number }
//   - updatedAt: timestamp (optional) — server write time
//
// ===============================================================
// Helper Functions
// ===============================================================

function isAuthenticated() {
  return request.auth != null;
}

function isOwner(userId) {
  return isAuthenticated() && request.auth.uid == userId;
}

function isAppDoc(docId) {
  return docId == 'app';
}

function isValidCoords(coords) {
  return coords == null
    || (coords is map
        && coords.keys().hasOnly(['lat', 'lng'])
        && coords.lat is number
        && coords.lng is number
        && coords.lat >= -90 && coords.lat <= 90
        && coords.lng >= -180 && coords.lng <= 180);
}

function isValidHomeAddress() {
  return !('homeAddress' in request.resource.data)
    || (request.resource.data.homeAddress is string
        && request.resource.data.homeAddress.size() <= 500);
}

function isValidWorkday() {
  return !('workday' in request.resource.data)
    || request.resource.data.workday == null
    || request.resource.data.workday is map;
}

function isValidAppData() {
  return request.resource.data.keys().hasOnly([
      'jobs', 'workday', 'homeAddress', 'homeCoords', 'updatedAt'
    ])
    && request.resource.data.jobs is list
    && request.resource.data.jobs.size() <= 200
    && isValidWorkday()
    && isValidHomeAddress()
    && isValidCoords(request.resource.data.get('homeCoords', null))
    && (!('updatedAt' in request.resource.data)
        || request.resource.data.updatedAt is timestamp);
}

// ===============================================================
// Security Rules
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/data/{docId} {
      allow read: if isOwner(userId) && isAppDoc(docId);
      allow create: if isOwner(userId) && isAppDoc(docId) && isValidAppData();
      allow update: if isOwner(userId) && isAppDoc(docId) && isValidAppData();
      allow delete: if isOwner(userId) && isAppDoc(docId);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
