{
  "name": "collins-lawncare-tracker",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:ios": "vite build && cap sync ios",
    "ios:open": "cap open ios",
    "ios:sync": "cap sync ios",
    "assets:generate": "capacitor-assets generate --ios",
    "firebase:keys": "./scripts/fetch-firebase-keys.sh",
