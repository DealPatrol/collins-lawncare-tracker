# Public browser configuration (Firebase web API keys identify the project;
# they do not grant access—Firestore rules enforce authorization).
VITE_FIREBASE_API_KEY=your-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-firebase-web-app-id
VITE_FIREBASE_MEASUREMENT_ID=your-measurement-id

# API base URL (empty = same origin; set for Capacitor iOS or split Vercel deploy)
VITE_API_BASE_URL=

# Stripe (publishable key is browser-safe; the other values are server-only)
VITE_STRIPE_PUBLIC_KEY=pk_test_replace_me
STRIPE_SECRET_KEY=rk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# SendGrid (server-only)
SENDGRID_API_KEY=SG.replace_me
SENDGRID_FROM_EMAIL=invoices@example.com

# Firebase Admin and portal links (server-only)
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"replace-me"}
PORTAL_TOKEN_SECRET=replace-with-at-least-32-random-bytes
APP_URL=http://localhost:5173
